; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="LudumDare60"
run/main_scene="res://scenes/main/opening.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="res://resources/audio/default_bus_layout.tres"

[autoload]

StartUp="*res://addons/maaacks_game_template/base/nodes/config/start_up/start_up.tscn"
SceneLoader="*res://addons/maaacks_scene_loader/base/nodes/autoloads/scene_loader/scene_loader.tscn"
ProjectMusicController="*res://scenes/audio/project_music_controller.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://resources/themes/menu_theme.tres"

[maaacks_game_template]

main_menu_scene_path="res://scenes/ui/menus/main_menu.tscn"
game_scene_path="res://scenes/main/game.tscn"

[maaacks_scene_loader]

loading_scene_path="res://addons/maaacks_scene_loader/base/nodes/loading_screen/loading_screen.tscn"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.065, 0.09, 1)
